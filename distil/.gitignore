# NEVER commit heavy artifacts (08_/09_..md guardrail — a past run hit 548 GB).
# Keep only result.json / config.yaml / run.log / RUN_STATE.md light leaves.
.env
__pycache__/
*.pyc
results/**/telemetry/
results/**/frames/
results/**/prompts/
results/**/*.pt
results/**/policy.pt
results/shared_bootstrap/
slurm_logs/
# allow the light leaves through:
!results/**/result.json
!results/**/config.yaml
!results/**/run.log
# smoke/plumbing runs are throwaway (fallback-mode) — never commit their leaves.
results/_smoke/
