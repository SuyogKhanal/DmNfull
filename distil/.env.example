# DISTIL — OpenRouter LLM credentials (never commit the real .env; SETUP_HPC2.md §3).
# The LLM is a pure OpenRouter API call: no local model weights, so HPC-B needs only
# this file + code + a GPU for the diffusion policy.
OPENROUTER_API_KEY=sk-or-...
OPENAI_BASE_URL=https://openrouter.ai/api/v1
VLM_MODEL_NAME=qwen/qwen3-vl-30b-a3b-instruct
LLM_MODEL_NAME=qwen/qwen3-32b
# Optional tuning:
# DISTIL_REASONING_HIGH=4096      # reasoning-token budget for analysis/decision (high effort)
# OAI_MAX_OUTPUT_TOKENS=16384     # overall max_tokens cap
# OAI_MAX_ATTEMPTS=4              # client-side retries on 429/5xx
