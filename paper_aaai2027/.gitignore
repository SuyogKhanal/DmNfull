# LaTeX build artifacts (regenerated by pdflatex/bibtex)
*.aux
*.log
*.blg
*.out
*.fls
*.fdb_latexmk
*.synctex.gz
*.toc
*.lof
*.lot

# generated by build_pdf.sh (pandoc -> .tex -> xelatex); regenerable, not source
COC_REPORT/CoC_Report.tex
COC_REPORT/build/CoC_Report.txt
COC_REPORT/build/CoC_Report.log

# AAAI paper build intermediates (regenerable). .bbl is KEPT: Overleaf/arXiv can
# typeset the bibliography from it without re-running bibtex.
overleaf_aaai/*.aux
overleaf_aaai/*.log
overleaf_aaai/*.blg
overleaf_aaai/*.out
